<div class="search-wrap">
  <p class="eyebrow">Where to next?</p>
  <form action="/listings/search" method="GET" role="search">
    <div class="search-card">

      <div class="field region">
        <span class="field-label">Region</span>
        <select name="region" aria-label="Select a region">
          <option value="" disabled selected>Anywhere</option>
          <option value="Europe">Europe</option>
          <option value="North America">North America</option>
          <option value="Southeast Asia">Southeast Asia</option>
          <option value="East Asia">East Asia</option>
          <option value="South America">South America</option>
          <option value="Middle East">Middle East</option>
        </select>
      </div>

      <div class="field date">
        <span class="field-label">Check in</span>
        <input name="check_in" type="text" placeholder="Add date" onfocus="this.type='date'" onblur="if(!this.value) this.type='text'" aria-label="Check in date">
      </div>

      <div class="field date">
        <span class="field-label">Check out</span>
        <input name="check_out" type="text" placeholder="Add date" onfocus="this.type='date'" onblur="if(!this.value) this.type='text'" aria-label="Check out date">
      </div>

      <div class="field guests">
        <span class="field-label">Guests</span>
        <input name="guests" type="number" min="1" placeholder="Add guests" aria-label="Number of guests">
      </div>

      <button class="search-btn" type="submit" aria-label="Search">
        <svg viewBox="0 0 24 24">
          <circle cx="11" cy="11" r="7" />
          <line x1="16.5" y1="16.5" x2="22" y2="22" />
        </svg>
        Search
      </button>

    </div>
  </form>
</div>